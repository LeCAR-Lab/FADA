*.pdf

# other
*.egg-info
__pycache__
build/
dist/

# Local model weights, checkpoints, and pipeline outputs.
# Ignore all of t1-models by default.
t1-models/
MUJOCO_LOG.TXT

# tools/bitexact/current/ is ephemeral output regenerated by tools/bitexact/run.sh
# (or manual probe invocations) for comparison against the checked-in
# tools/bitexact/golden/ baseline. Never a source of truth, so keep it untracked.
tools/bitexact/current/

# Resource-monitor probe traces (e.g. btop/bpytop) that land in the repo root
# depending on cwd when a run is interrupted.
*.btr
