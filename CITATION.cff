# `repository-code` is supplied when the public tree is built -- the URL does not
# exist until the repository does -- and is verified inside that tree before the
# release commit is made, so it is part of the byte-verified published history
# rather than an edit pushed after verification ran. In the development tree this
# line carries a placeholder token instead of a URL; the build refuses to run
# without it.
repository-code: "https://github.com/LeCAR-Lab/FADA"
# Verified against LICENSE, which is byte-identical to upstream Holosoma's.
license: Apache-2.0
